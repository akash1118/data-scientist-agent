# .env.example
# ---------------
# WHY: The app needs a Google Gemini API key to talk to the LLM. We never hard-code
#      secret keys in source code, so we read them from environment variables instead.
# WHAT: Copy this file to a new file named ".env" and fill in your real key.
# HOW:  1) Get a free API key from https://aistudio.google.com/app/apikey
#       2) Run:  cp .env.example .env
#       3) Paste your key below (the real .env file is git-ignored, so it stays private)

# Your Google Gemini API key (required)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Which Gemini model to use for chat / reasoning tasks.
# "gemini-2.5-flash" is fast and cheap - great for a classroom demo.
# You can switch to "gemini-2.5-pro" for higher quality answers.
GEMINI_MODEL=gemini-2.5-flash

# Which Gemini model to use for turning text into embeddings (used by the RAG agent).
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Optional: controls how "creative" vs "deterministic" the LLM answers are.
# 0.0 = very focused and repeatable, 1.0 = more creative/random.
LLM_TEMPERATURE=0.3
