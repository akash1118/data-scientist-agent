# .env.example
# ---------------
# WHY: The app needs API keys to talk to an LLM. We never hard-code secret
#      keys in source code, so we read them from environment variables instead.
# WHAT: Copy this file to a new file named ".env" and fill in your real key(s).
# HOW:  1) Get a free API key from https://aistudio.google.com/app/apikey
#       2) Run:  cp .env.example .env
#       3) Paste your key below (the real .env file is git-ignored, so it stays private)

# --- Google Gemini settings (PRIMARY chat provider) ---
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Which Gemini model to use for chat / reasoning tasks.
# "gemini-2.5-flash" is fast and cheap - great for a classroom demo.
# You can switch to "gemini-2.5-pro" for higher quality answers.
GEMINI_MODEL=gemini-2.5-flash

# --- Groq settings (OPTIONAL automatic FALLBACK chat provider) ---
# If you fill these in, get_llm() in utils/llm.py automatically wraps Gemini
# with Groq as a backup: if a call to Gemini fails (rate limit, quota,
# network error, bad key...), LangChain silently retries with Groq instead
# of crashing the app. Leave GROQ_API_KEY blank/placeholder to disable this.
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# "llama-3.1-8b-instant" is one of Groq's cheapest, fastest models - a great
# fit for a classroom demo. Other options: "llama-3.3-70b-versatile" (smarter,
# still cheap), "gemma2-9b-it".
GROQ_MODEL=llama-3.1-8b-instant

# --- Embeddings (used only by the RAG Agent / "Ask your Dataset" page) ---
# Runs locally on your machine using an open-source "sentence-transformers"
# model - NO API key needed, and it keeps working even if Gemini and Groq
# are both unavailable. "all-MiniLM-L6-v2" is small (~90MB) and fast, which
# is why it's such a common teaching example for lightweight local embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: controls how "creative" vs "deterministic" the LLM answers are.
# 0.0 = very focused and repeatable, 1.0 = more creative/random.
LLM_TEMPERATURE=0.3
